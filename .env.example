# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=replace-with-a-long-random-string

# --- MySQL ---
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=charam_movies
# Optional: overrides the pieces above with a full URL if set
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/charam_movies?charset=utf8mb4

# --- JWT ---
JWT_SECRET_KEY=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_MIN=60
JWT_REFRESH_EXPIRES_DAYS=7

# --- CORS ---
# Comma-free single origin, or * for all origins during local development
CORS_ORIGINS=*

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
